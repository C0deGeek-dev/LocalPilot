<Window x:Class="Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes reference" Width="360" Height="180">
  <StackPanel Margin="16">
    <Button x:Name="SaveButton" AutomationProperties.AutomationId="save"
            Content="Save" Click="OnSave" Width="120" HorizontalAlignment="Left" />
    <TextBlock x:Name="Status" AutomationProperties.AutomationId="status"
               Margin="0,12,0,0" Text="Not saved" />
  </StackPanel>
</Window>
