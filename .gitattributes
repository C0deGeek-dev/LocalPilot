# Normalize tracked text to LF in the repository so behaviour is identical on
# Windows, Linux, and macOS (ADR-0007, docs/13 §7). Binary assets are left alone.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Render snapshots preserve terminal-cell padding as observable geometry.
*.snap -whitespace

# The embedded companion app is pinned by digest: its bytes must reach every
# checkout exactly as committed.
crates/localpilot-cli/client/** -text
